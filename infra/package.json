{
  "name": "agent-stack",
  "version": "1.0.0",
  "description": "Agent Stack infrastructure controller",
  "main": "controller.ts",
  "scripts": {
    "start": "tsx controller.ts",
    "generate-openapi": "npx tsx generate-openapi.ts > ../config/wiki/openapi.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/config.test.ts lib/routes.test.ts lib/sidecar.test.ts lib/services.test.ts lib/types.test.ts lib/perf.test.ts",
    "test:runtime": "tsx --test lib/runtime.test.ts",
    "test:all": "npm test && npm run test:runtime"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
