# LLM API Configuration
# Point to free-llm-router (OpenAI-compatible proxy, runs as systemd service on host):
#   From container: http://host.containers.internal:3000/v1
#   From host:      http://localhost:3000/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=http://free-llm-router:3000/v1
LLM_MODEL=gpt-4o
IMAGE_MODEL=dall-e-3

# Server
PORT=3001
JWT_SECRET=change-this-to-a-random-secret
