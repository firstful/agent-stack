FROM docker.io/library/node:22 AS builder

WORKDIR /app
RUN npm config set registry https://registry.npmjs.org/

# Builder only needs frontend deps — skip Chromium download
ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx vite build

FROM docker.io/library/node:22

WORKDIR /app
RUN npm config set registry https://registry.npmjs.org/

# Chromium + Puppeteer system dependencies
# Chromium is installed system-wide so Puppeteer doesn't need to download
# its own copy (saves ~300MB in the image)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Using system Chromium (installed via apt above), so skip Puppeteer's
# bundled download to save ~300MB in the image and avoid network timeouts
ENV PUPPETEER_SKIP_DOWNLOAD=true

RUN npm ci --omit=dev --legacy-peer-deps

COPY server/ ./server/
COPY --from=builder /app/dist/ ./dist/

ENV PORT=3001
ENV NODE_ENV=production

RUN mkdir -p /app/data

EXPOSE 3001

CMD ["npx", "tsx", "server/index.ts"]
