{
  "name": "obsidian-livesync",
  "version": 2,
  "container": {
    "port": 5984,
    "auto_port": true,
    "volumes": [
      "obsidian-livesync-data:/opt/couchdb/data"
    ],
    "env": {
      "COUCHDB_USER": "admin",
      "COUCHDB_PASSWORD": "7cpty2H6TRgrNd1wYTYHipf1",
