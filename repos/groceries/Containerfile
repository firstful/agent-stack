# ─── Groceries FFILT.US Web Service ─────────────────────────────────────
FROM docker.io/library/python:3.14-slim-bookworm

WORKDIR /app

# System dependencies (minimal — no browser needed for serving)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY core/ ./core/
COPY models/ ./models/
COPY storage/ ./storage/
COPY planners/ ./planners/
COPY scrapers/ ./scrapers/
COPY web/ ./web/
COPY main.py .

# Data directory (volume mount point)
RUN mkdir -p /app/data /app/profiles

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# Expose web port
EXPOSE 8080

# Run web server
CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8080"]
