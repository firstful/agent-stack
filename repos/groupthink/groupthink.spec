{
  "name": "groupthink",
  "deployments": ["react-native-android", "react-native-ios", "web", "mobile-web"],
  "tech-stack": {
    "frontend": {
      "android-ios": "React Native via Expo — one codebase for both native mobile platforms.",
      "mobile-web": "React Native via Expo (web target) — mdot-style route with touch-optimized layout, sharing components and logic with native apps via platform files.",
      "desktop-web": "Next.js (React) — dedicated 1920x1080 layout with proper CSS, SSR, and SEO for public pages. Shares API client, types, and auth layer with Expo apps via a common package."
    },
    "backend": {
      "runtime": "Node.js / TypeScript on Hono.",
      "database": "PostgreSQL via Drizzle ORM — groups, members, impulses, votes, messages, DMs.",
      "cache-queue": "Redis — adaptive voting timers, impulse queue ordering, hotness scoring, real-time push."
    },
    "llm": {
      "endpoint": "OpenAI-compatible (BYO provider).",
      "usage": "Summary generation from locked impulse threads; content moderation via system prompts with banned words library."
    },
    "infrastructure": "Podman containers managed by agent-stack. Postgres and Redis run as sidecar containers on the same stack-net."
  },
  "description": "A group-based social platform where members vote on inter-group communications mediated by an LLM via OpenAI-compatible endpoint, with adjustable group 'energy' (thoughtful, snarky, funny, mixed) that tailors the tone of generated responses. Private group activities (voting, drafting, kick votes, impulse discussions) stay hidden, while finalized inter-group messages are public.",
  "features": {
    "group-creation": "Anyone can create a group, but it only becomes visible to others once it reaches 5 members (invite-only until then). Groups are tiered by member count: fringe (1-4, hidden), small (5-49), medium (50-199), large (200-999), huge (1k-9,999), massive (10k+). Groups can limit which tiers they interact with (impulses in, replies, retweets) but cannot exclude their own tier. Users can filter their feed to hide groups below a certain tier.",
    "group-membership": "Users join via invite codes generated by existing members, scaled to total platform users — generous early on (1 per day per member), tapering as platform matures (10k users = 1 per week, 100k = 1 per month per member). Membership lists are full and visible globally. Join limits are tenure-scaled — new users can join up to 2 groups; longer-tenured users can join more, preventing rapid multi-group vote manipulation. Possible algorithms: linear ramp (1 additional slot per 30 days of account age), or log ramp (slots = floor(log2(days active))).",
    "group-interaction": "Any group member can create an impulse - a proposed action to initiate communication with another group. Replying to a public post from another group auto-creates an impulse with that post as context. If an impulse for that target already exists, the user is redirected to it. Impulses enter a tenure-weighted queue — higher-tenure members' impulses are positioned higher, ensuring group attention goes to experienced members first. Impulses require sufficient votes within a time window to advance to the composer modal.",
    "voting-mechanism": "Adaptive voting windows — the timer starts at a max duration (e.g., 4 hours) and dynamically shrinks as engagement increases. If enough members vote early and consensus is clear, the window collapses to minutes. Low-engagement items take the full window. Vote thresholds are a combined function of raw vote count and tenure-weighted approval percentage. Possible algorithms: threshold = min(count * tenure_weight, group_size * 0.3) with adaptive floor. Vote-kick allows removal of disruptive members via majority vote after review period.",
    "composer-modal": "Members draft messages in a threaded chat interface (like a Reddit comment thread). The thread remains open for drafting until lock conditions are met (adaptive timer based on engagement). Once locked, the LLM (via OpenAI-compatible endpoint) produces 2-3 summary candidates based on the full discussion, with the prompt tailored to the group's currently selected energy. No more drafting after lock.",
    "summary-approval": "Group votes on which summary to send or to discard the draft via the same adaptive voting mechanism, allowing the group to agree on sentiment and wording from the LLM-generated options.",
    "public-broadcast": "Approved inter-group messages (selected LLM summaries) are visible to all users, regardless of group membership, appearing as the group's official response to the original post. Messages are permanent — no true deletes, only revocation with a notice banner.",
    "group-energy": "Groups can set their communication 'energy' (thoughtful, snarky, funny, mixed) which tailors the LLM's prompt when generating response options. Groups can hold multiple energies and switch via vote with a 72-hour cooldown between changes to prevent spam.",
    "group-bio": "A short public slogan/description set by group vote. Displayed on the group's public profile beneath the group name.",
    "reputation-decay": "Voting weight slowly decays if a member goes inactive. Prevents dead-weight from permanently influencing votes. Possible algorithms: linear decay over 3-6 months of inactivity to a minimum floor (e.g., 10% of accumulated weight); exponential decay (weight halves every 60 days inactive).",
    "impulse-queue": "Active impulses are queued rather than capped. Queue position is determined by the creator's tenure — higher-tenure members' impulses are surfaced first. Prevents low-tenure impulse spam while maintaining a fair throughput.",
    "group-retweet": "Groups can publicly endorse a message from another group with a single click. The endorsement appears below the original post showing which group endorsed it. Global rate limits apply — all groups share a cap on posts, replies, and retweets per time window to prevent spam.",
    "group-nicknames": "Groups can assign public nicknames or flairs to other groups (e.g., 'the opposition'). Visible in the context of interactions between those two groups. Adds character without cluttering the global feed. Set via internal vote.",
    "post-revocation": "For 24 hours after a message is published, a group can vote to disown or revoke it. Requires a supermajority vote (higher threshold than standard). Triggered when members believe a post was made by a colluding subset (e.g., during off-hours). Revoked posts are marked with a visible notice on the public message, preserving transparency while disavowing the content.",
    "impulse-visibility": "Active impulses are held in a tenure-weighted queue visible to all group members (via hotness-weighted sampling within each queue tier). Higher-tenure members' impulses are surfaced first. More active impulses rise within their tier. Low-activity impulses by low-tenure members naturally fade without explicit blocking.",
    "conversation-threads": "When Group A responds to a post from Group B and Group B responds back, the exchange forms a visible public thread. Threads are chronological and show the full back-and-forth between groups, giving historical context to relationships.",
    "group-sabbatical": "A group can vote to enter read-only mode for a set period (e.g. 1-7 days). No new impulses or voting during sabbatical. Members can still read public and private content.",
    "group-timezone": "Optional time zone setting for groups that are regional. Affects when voting windows start and end relative to the group's local day, and is displayed on public messages for temporal context.",
    "content-moderation": "No image content supported at launch — text-only. A banned words library is maintained centrally. LLM prompts for all outward-facing content (summaries, broadcasts) include content rules and the banned words list as system instructions; the LLM acts as the content guardian.",
    "search": "Search covers group names, group bios, and all public inter-group messages. A separate search modal allows members to search content within their own groups (impulses, drafts, discussions, votes).",
    "private-tools": "All voting, drafting, kick-vote UI, impulse tracking and discussions are private to the originating group. Group members can send direct messages to each other within the group (visible only to sender and recipient, not to the full group).",
    "group-split": "A group can split into two via internal vote. Members choose which resulting group to join; tenure carries over to the chosen group. The original group name is preserved by the majority faction; the splinter faction creates a new named group.",
    "group-merge": "Two groups can merge into one via mutual vote — both groups must independently vote to approve the merge. Combined membership and tenure merge into the surviving group identity.",
    "account-creation": "OAuth only (Google, GitHub, Apple) — leverages existing account reputation. Cloudflare Turnstile on sign-up as a lightweight bot barrier. No email/password or SMS flows; no phone number required.",
    "fraud-detection": "Multi-layer anti-sock-puppet system: (1) Tenure-weighted voting — influence scales continuously with membership duration, not a binary gate. (2) Activity gate — voting weight ramps up only with genuine engagement; pure vote-only accounts never gain full influence. (3) Cohort analysis — accounts created in the same time window that vote together on the same targets are flagged as a bloc and suppressed collectively. (4) Cross-group observation — accounts that only join and vote in the same clusters and never diverge are flagged. (5) Vouch system — established members can vouch for new accounts to accelerate their weight; unvouched accounts have a hard cap on influence regardless of tenure. (6) Behavioral heuristics — coordinated voting patterns trigger weight reductions."
  },
  "desktop-web-ui": {
    "layout": "Three-panel layout optimized for 1920x1080+ screens: left navigation (groups list), center main content, right sidebar (group details/member list when in group context).",
    "views": {
      "home-feed": "Displays public inter-group messages from all groups, filtered by the user's minimum tier setting. Each post includes the sending group's name, tier, bio, group bio, nickname (if assigned by viewer's group), energy, and a 'Reply' button that creates an impulse targeting that post. Posts show endorsement count (group retweets) with which groups endorsed. Revoked posts display a visible banner. Sorting: newest, popular.",
      "group-detail": "The primary private view for a group. Shows the group's current tier prominently. Contains: tenure-weighted impulses queue (vote to advance, inline adaptive timer, vote tally with tenure breakdown), member roster (full list with tenure indicators and activity status), settings panel (bio editor, energy selector with 72hr cooldown indicator, time zone, nickname manager, governance actions like split/merge, sabbatical vote). If on sabbatical, displays a banner and disables impulse creation. New impulse creation is inline or slide-out. Accessible only to members.",
      "composer-modal": "Full-screen modal entered when an impulse reaches its vote threshold. Members draft in a threaded chat layout (Reddit-style comment tree). The thread shows an adaptive timer. When locked, drafting stops and the LLM generates 2-3 summary options with voting buttons. Shows which summary was selected and broadcasts the result on close.",
      "member-profile": "Public profile showing user's group memberships and public message history."
    },
    "nav-elements": {
      "search-bar": "Persistent search in the navigation header for groups, users, and public messages; scope toggle for searching within the user's own groups. Filters accessible via dropdown."
    },
    "styling": "Clean, modern design with emphasis on readability; group-specific color accents for private sections; neutral tones for public feed."
  },
  "mobile-web-ui": {
    "layout": "Single-column, touch-optimized layout for mobile browsers. Bottom navigation bar with 4 tabs: Feed, Groups, Messages, Profile.",
    "views": {
      "group-detail": "Tabbed interface within a selected group: Impulses (tenure-weighted queue with inline adaptive timer, expandable for tenure breakdown), Members (full roster with tenure and activity), Settings (bio editor, energy selector with 72hr cooldown, time zone, nickname manager, governance, sabbatical vote). New impulse is inline. Sabbatical banner shown when active; impulse creation disabled. Only accessible to group members.",
      "composer-modal": "Full-screen drafting interface with threaded comment layout; LLM summaries appear as selectable cards after lock.",
      "member-profile": "Scrollable profile showing group affiliations, public contributions, and reputation."
    },
    "nav-elements": {
      "search-bar": "Persistent search in the top nav for groups/users/public messages with scope toggle for intra-group search; slide-up filter panel."
    },
    "styling": "Touch-friendly design with minimum 48px tap targets; platform-appropriate animations; reduced visual density for mobile contexts."
  }
}