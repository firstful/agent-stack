# .stackignore — files matching these patterns do NOT trigger container rebuilds.
# Gitignore-style syntax. Changes to these files are excluded from the
# content hash used by the agent-stack controller to decide rebuilds.
#
# To force a rebuild despite ignoring a file:
#   - Remove the pattern from this file, or
#   - Touch any non-ignored file (e.g., agent-stack.json)

# Documentation and changelogs — no rebuild needed
*.md
docs/
CHANGELOG*
LICENSE*

# Metadata and config that doesn't affect the container build
.gitignore
.gitattributes
.env
.env.*
*.yml
*.yaml
agent-stack.json

# Build artifacts (not part of container image)
dist/
build/
node_modules/
__pycache__/
*.pyc
.pnpm-store/
pnpm-lock.yaml
package-lock.json
