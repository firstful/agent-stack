{
  "name": "groupthink",
  "repo": "/srv/agent-stack/repos/groupthink",
  "version": 2,
  "container": {
    "port": 3000,
    "auto_port": true,
    "healthCheck": {
      "path": "/health/live"
    },
    "env": {
      "DATABASE_URL": "postgres://groupthink:***@groupthink--db:5432/groupthink",
      "REDIS_URL": "redis://groupthink--redis:6379",
      "LLM_ENDPOINT": "http://host.containers.internal:8080/v1/chat/completions",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://observability--otel-collector:4318",
      "OTEL_SERVICE_NAME": "groupthink",
      "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=production"
    },
    "volumes": ["/srv/agent-stack/config/groupthink:/config"],
    "sidecars": [
      {
        "name": "db",
        "image": "docker.io/postgres:16-alpine",
        "port": 5432,
        "env": {
          "POSTGRES_USER": "groupthink",
          "POSTGRES_PASSWORD": "groupthink",
          "POSTGRES_DB": "groupthink"
        },
        "volumes": ["groupthink-pgdata:/var/lib/postgresql/data"]
      },
      {
        "name": "redis",
        "image": "docker.io/redis:7-alpine",
        "port": 6379,
        "volumes": [
          "groupthink-redis-data:/data",
          "/srv/agent-stack/config/groupthink/redis.conf:/usr/local/etc/redis/redis.conf:ro"
        ],
        "command": ["redis-server", "/usr/local/etc/redis/redis.conf"]
      }
    ]
  },
  "expose": {
    "hostname": "groupthink.ffilt.us",
    "tunnel": "ffilt-us",
    "enabled": true
  }
}
