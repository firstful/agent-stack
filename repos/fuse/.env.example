# Node / Express
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres
DATABASE_URL=postgresql://fuselocal:fuselocalpw@postgres:5432/fuse?schema=public

# WebSocket
WS_PORT=3000

# SMTP / Maddy
SMTP_PORT=587
MADDY_SMTP_PORT=2525
MADDY_HOST=maddy
MADDY_PORT=2525

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=fuselocal
S3_SECRET_KEY=fuselocalpw
S3_BUCKET=fuse-media

# Security / Auth
SESSION_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production
MAGIC_LINK_TOKEN_TTL=86400

# Domain / Federation
FUSE_DOMAIN=local.fuse.dev
TRUST_LEVEL_THRESHOLD=2

#compute
FUSE_SOCKET=caddy/hmi/ttyS1

# Third-party OAuth (fill in before enabling)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Logging
LOG_LEVEL=info
