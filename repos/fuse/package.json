{
  "name": "fuse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/cloud"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/server",
    "build:all": "npm run build && npm run build -w packages/cloud",
    "dev": "npm run dev -w packages/core & npm run dev -w packages/server",
    "start": "node packages/server/dist/index.js",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "typecheck": "tsc -b packages/*/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.8.0",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
