{
  "name": "fuse",
  "version": 1,
  "container": {
    "port": 3000,
    "auto_port": true,
    "env": {
      "NODE_ENV": "production",
      "HOST": "0.0.0.0",
      "DATABASE_URL": "postgresql://fuselocal:fuselocalpw@fuse--db:5432/fuse",
      "SESSION_SECRET": "8f91716bb10846c427e319a9ffb636e22b1cf9e4be42afa8651157cf93457dce",
      "JWT_SECRET": "6aa9e2220a86b1f61a3daa1d77aa25328bd48b30de5f85338dc450954340c4d1",
      "MAGIC_LINK_TOKEN_TTL": "86400",
      "LOG_LEVEL": "info",
      "FUSE_DOMAIN": "fuse.ffilt.us",
      "MADDY_HOST": "fuse--maddy",
      "MADDY_SMTP_PORT": "2525",
      "S3_ENDPOINT": "http://fuse--minio:9000",
      "S3_ACCESS_KEY": "fuselocal",
      "S3_SECRET_KEY": "fuselocalpw",
      "S3_BUCKET": "fuse-media",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://observability--otel-collector:4318",
      "OTEL_SERVICE_NAME": "fuse",
      "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=production"
    },
    "sidecars": [
      {
        "name": "db",
        "image": "docker.io/postgres:16-alpine",
        "env": {
          "POSTGRES_USER": "fuselocal",
          "POSTGRES_PASSWORD": "fuselocalpw",
          "POSTGRES_DB": "fuse"
        },
        "volumes": ["fuse-pgdata:/var/lib/postgresql/data"]
      },
      {
        "name": "maddy",
        "image": "docker.io/foxcpp/maddy:latest",
        "volumes": [
          "/srv/agent-stack/repos/fuse/maddy.conf:/config/maddy.conf:ro",
          "fuse-maddy-data:/data"
        ]
      },
      {
        "name": "minio",
        "image": "docker.io/minio/minio:latest",
        "env": {
          "MINIO_ROOT_USER": "fuselocal",
          "MINIO_ROOT_PASSWORD": "fuselocalpw"
        },
        "volumes": ["fuse-minio-data:/data"],
        "command": ["server", "/data", "--console-address", ":9001"]
      }
    ]
  },
  "expose": {
    "enabled": true,
    "hostname": "fuse.ffilt.us",
    "tunnel": "ca308a1b-557a-4a18-9350-6eec27465bdf"
  },
  "build": {
    "podman_args": "--memory 2g"
  }
}
