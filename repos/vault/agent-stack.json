{
  "name": "vault",
  "version": 2,
  "container": {
    "port": 3500,
    "auto_port": true,
    "volumes": [
      "vault-data:/data"
    ],
    "env": {
      "PORT": "3500",
      "VAULT_PASSWORD": "techdeck-vault-token",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://observability--otel-collector:4318",
      "OTEL_SERVICE_NAME": "vault",
      "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=production"
    }
  },
  "expose": {
    "enabled": true,
    "hostname": "vault.ffilt.us",
    "tunnel": "ca308a1b-557a-4a18-9350-6eec27465bdf"
  },
  "logo": {
    "_type": "file",
    "isRelative": true,
    "fileName": ".logo.svg"
  }
}