FROM docker.io/library/node:24

RUN apt-get update && apt-get install -y \
    git curl lsof ripgrep ca-certificates grep gawk sed findutils \
    coreutils procps jq less tree file python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@latest --activate

RUN curl -fsSL https://bun.sh/install | bash && \
    mv /root/.bun /opt/bun && \
    chmod -R 755 /opt/bun && \
    ln -s /opt/bun/bin/bun /usr/local/bin/bun

WORKDIR /app

RUN git clone --depth=1 https://github.com/chriswritescode-dev/opencode-manager.git .

RUN pnpm install --frozen-lockfile

RUN pnpm --filter shared build 2>/dev/null; \
    pnpm --filter frontend build

RUN npm install -g @kilocode/cli

COPY opencode-wrapper.sh /usr/local/bin/opencode
RUN chmod +x /usr/local/bin/opencode

RUN cp /app/scripts/docker-entrypoint.sh /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=5003
ENV OPENCODE_SERVER_PORT=5551
ENV DATABASE_PATH=/app/data/opencode.db
ENV WORKSPACE_PATH=/workspace

RUN mkdir -p /workspace /app/data /repos

EXPOSE 5003

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5003/api/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["bun", "backend/src/index.ts"]
