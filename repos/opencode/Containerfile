FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y gh git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN mkdir -p /repos
WORKDIR /repos

COPY gh-check.sh /usr/local/bin/gh-check
RUN chmod +x /usr/local/bin/gh-check

ENV APP_PORT=3000
CMD gh-check & exec npx opencode-ai serve --port ${APP_PORT} --hostname 0.0.0.0
