{
  "name": "openchamber",
  "version": 4,
  "container": {
    "port": 3000,
    "auto_port": true,
    "env": {
      "OPENCODE_SKIP_START": "true",
      "OPENCODE_HOST": "http://slot-proxy:80/proxy/opencode",
      "OPENCHAMBER_HOST": "0.0.0.0",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://observability--otel-collector:4318",
      "OTEL_SERVICE_NAME": "openchamber",
      "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=production"
    },
    "volumes": [
      "openchamber-data:/root/.config/openchamber"
    ]
  },
  "expose": {
    "hostname": "chamber.ffilt.us",
    "tunnel": "ca308a1b-557a-4a18-9350-6eec27465bdf",
    "enabled": true
  }
}
