{
    "routes": [
        {
            "route": "/wip/*",
            "allowedRoles": ["internal"]
        },
        {
            "route": "/login",
            "allowedRoles": ["anonymous"],
            "rewrite": "/.auth/login/google"
        },
        {
            "route": "/logout",
            "allowedRoles": ["authenticated"],
            "rewrite": "/.auth/logout"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/assets/*"
        ]
    },
    
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": ".auth/login/google?post_login_redirect_uri=.referrer"
        }
    },
}
